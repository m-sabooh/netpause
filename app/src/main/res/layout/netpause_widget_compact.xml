<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background"
    android:theme="@android:style/Theme.Material.Light.NoActionBar" android:layoutDirection="locale">
    <LinearLayout android:id="@+id/widget_brand_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="11sp" android:textColor="#755466"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textDirection="ltr" />
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="end"
            android:textSize="11sp" android:textColor="#755466" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="48dp" android:orientation="vertical" android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_open_app">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_unknown" android:textSize="14sp" android:textColor="#361828"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="#755466"
            android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#361828" android:textSize="22sp" android:fontFamily="monospace"
            android:includeFontPadding="false" android:countDown="true" android:textDirection="ltr" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_checked" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#755466" android:includeFontPadding="false" android:paddingBottom="4dp" />
    <include layout="@layout/widget_actions" />
</LinearLayout>
