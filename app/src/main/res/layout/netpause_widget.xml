<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:theme="@android:style/Theme.Material.Light.NoActionBar"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/widget_open_app">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_pause" android:tint="#755466" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:text="@string/app_name" android:textSize="12sp"
            android:textColor="#755466" android:fontFamily="sans-serif-medium" android:textDirection="ltr" />
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="end"
            android:text="@string/widget_refresh_required" android:textSize="11sp" android:textColor="#755466" />
    </LinearLayout>

    <RelativeLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_toStartOf="@+id/widget_countdown" android:layout_alignWithParentIfMissing="true" android:layout_centerVertical="true">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_unknown" android:textColor="#361828" android:textSize="18sp"
                android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/stale_status" android:textColor="#755466" android:textSize="11sp"
                android:maxLines="3" android:ellipsize="end" />
        </LinearLayout>
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:layout_marginStart="10dp" android:textColor="#361828" android:textSize="30sp"
            android:fontFamily="monospace" android:countDown="true" android:textDirection="ltr" android:visibility="gone" />
    </RelativeLayout>

    <TextView android:id="@+id/widget_checked" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#755466" android:textSize="11sp" android:paddingBottom="8dp" />
    <LinearLayout android:id="@+id/widget_idle_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/widget_pause" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:background="@drawable/widget_primary" android:backgroundTint="@null" android:textColor="#FFFFFF"
            android:text="@string/pause_everyone" android:textSize="12sp" android:textAllCaps="false"
            android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
        <Button android:id="@+id/widget_timed" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" android:minHeight="48dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:background="@drawable/widget_secondary" android:backgroundTint="@null" android:textColor="#361828"
            android:text="@string/widget_timed_preview" android:textSize="12sp" android:textAllCaps="false"
            android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <Button android:id="@+id/widget_primary" style="?android:attr/buttonBarButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:background="@drawable/widget_secondary" android:backgroundTint="@null" android:textColor="#361828"
        android:text="@string/refresh_status" android:textSize="12sp" android:textAllCaps="false"
        android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
